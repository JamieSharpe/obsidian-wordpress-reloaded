{
  "plugins": {
    "@release-it/conventional-changelog": {
      "preset": "angular",
      "infile": "CHANGELOG.md"
    }
  },
  "git": {
    "tagName": "${version}",
    "commitMessage": "chore(release): ${version}"
  },
  "npm": {
    "publish": false
  },
  "hooks": {
    "after:bump": "node version-bump.mjs && git add manifest.json versions.json"
  }
}
